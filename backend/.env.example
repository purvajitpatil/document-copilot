# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Runtime ---

# development | test | production. In production: JSON logs, API docs off,
# HSTS header on, and wildcard CORS rejected at startup.
APP_ENV=development
LOG_LEVEL=INFO

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Postgres (Alembic + direct DB access) ---

# Use the DIRECT connection (host: db.<ref>.supabase.co).
# Do NOT use the transaction pooler URL (pooler.supabase.com) — migrations require a session connection.
# URL-encode special characters in the password.

DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- LLM gateway (any OpenAI-compatible endpoint) ---
#
# Recommended: a self-hosted OmniRoute gateway that fans requests out to free
# providers with automatic fallback. See docs/guides/omniroute-setup.md.
#   Local dev (OmniRoute on your machine):  http://localhost:20128/v1
#   docker compose (service name):          http://omniroute:20128/v1
# LLM_API_KEY is the key from OmniRoute's dashboard (Endpoints). If you run
# OmniRoute with REQUIRE_API_KEY=false locally, any non-empty value works.
#
# Other options: OpenRouter (https://openrouter.ai/api/v1) or OpenAI (leave
# LLM_BASE_URL unset and use real OpenAI model names).

LLM_API_KEY=your-omniroute-api-key
LLM_BASE_URL=http://localhost:20128/v1

# `auto` lets OmniRoute pick the best healthy free model. Variants: auto/fast,
# auto/smart, auto/coding. You can also name a combo you created in the dashboard.
# The chat model must support tool calling (or set LLM_OUTPUT_MODE=prompted).
LLM_CHAT_MODEL=auto
# Used for citation grounding checks. Accuracy matters here — prefer auto/smart.
LLM_GROUNDING_MODEL=auto/smart
# Used for short helper calls (thread titles). Falls back to LLM_GROUNDING_MODEL.
LLM_FAST_MODEL=auto/fast

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# tool     = function-calling output (OpenAI-class models, strong free models)
# prompted = JSON requested in the prompt and parsed (use with weaker free models)
LLM_OUTPUT_MODE=tool
# json_schema -> json_object -> prompt: the gateway starts strict and steps down
# automatically if a model rejects the stricter mode. Lower this to skip attempts.
LLM_STRUCTURED_MODE=json_schema

OPENAI_AGENT_REQUEST_LIMIT=20
OPENAI_AGENT_TEMPERATURE=0

# --- Embeddings ---
#
# Defaults to the OpenAI API. IMPORTANT: the pgvector column is vector(1536) and
# every stored chunk was embedded with this exact model. Changing the model or
# dimension requires re-running ingestion for the whole corpus (see
# docs/guides/omniroute-setup.md#free-embeddings). Until then, keep OpenAI here —
# or point EMBEDDING_BASE_URL at OmniRoute with a model that returns the same
# dimension.

EMBEDDING_API_KEY=sk-your-openai-api-key
# EMBEDDING_BASE_URL=http://localhost:20128/v1
# Legacy alias for EMBEDDING_API_KEY (still honoured).
# OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_TIMEOUT_SECONDS=10
EMBEDDING_MAX_RETRIES=2
# Set false if your embedding provider rejects the `dimensions` parameter.
EMBEDDING_SEND_DIMENSIONS=true

# --- Retrieval (hybrid search defaults) ---

RETRIEVAL_CANDIDATE_K=50
RETRIEVAL_TOP_K=10
RETRIEVAL_RRF_K=60
RETRIEVAL_NEIGHBOR_RADIUS=1
RETRIEVAL_FTS_CONFIG=english
# Keyword extraction for full-text search (short call; deterministic fallback on failure).
RETRIEVAL_FTS_KEYWORD_MODEL=auto/fast
RETRIEVAL_FTS_KEYWORD_MIN=3
RETRIEVAL_FTS_KEYWORD_MAX=5
RETRIEVAL_FTS_KEYWORD_FAST_PATH_TOKENS=5

# --- Abuse protection ---

RATE_LIMIT_ENABLED=true
# Chat turns per user per rolling minute (enforced per backend process).
RATE_LIMIT_CHAT_PER_MINUTE=20
MAX_MESSAGE_CHARS=4000

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
# Must be explicit origins in production (no wildcard).
ALLOWED_ORIGINS=http://localhost:5173
# Interactive docs at /docs. Defaults to on in development, off in production.
# ENABLE_API_DOCS=false
