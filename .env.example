# Compose-level settings for `docker compose up` (see docker-compose.yml).
# Backend application settings live in backend/.env (see backend/.env.example).

# --- OmniRoute (free-model AI gateway) ---
# Dashboard login password. Required; pick something long and random.
OMNIROUTE_INITIAL_PASSWORD=
# API key the backend uses to call OmniRoute. Create it in the dashboard:
#   http://127.0.0.1:20128  ->  Endpoints  ->  copy key
OMNIROUTE_API_KEY=
# Optional: fix these for reproducible deployments (auto-generated into the data
# volume on first boot if left empty). Generate with: openssl rand -hex 32
OMNIROUTE_JWT_SECRET=
OMNIROUTE_API_KEY_SECRET=
OMNIROUTE_STORAGE_ENCRYPTION_KEY=

# --- Frontend build-time values (public, browser-safe) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
